# Configuración de Base de datos (Local o Docker)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=unieventos

# Configuración JWT (Seguridad)
JWT_SECRET=dev_secret_cambiar_en_produccion

# VideoSDK — transmisiones en vivo (https://app.videosdk.live/api-keys)
# Obligatorio para iniciar HLS. No uses los valores de ejemplo en producción.
VIDEOSDK_API_KEY=
VIDEOSDK_SECRET_KEY=
